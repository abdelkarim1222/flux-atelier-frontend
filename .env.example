# Connexion privée au serveur PostgreSQL (ne jamais préfixer par VITE_).
DATABASE_URL=postgresql://flux_app:change-this-password@localhost:5432/flux_atelier
API_PORT=3001

# Générer une valeur aléatoire longue et privée pour signer les sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Compte administrateur initial créé uniquement si la table accounts est vide.
INITIAL_ADMIN_NAME=Administrateur
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
